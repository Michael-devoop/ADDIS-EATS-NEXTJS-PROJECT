# ==============================================================================
# Addis Eats Environment Configuration Template (Day 48 Production Pre-Flight)
# ==============================================================================
# SECURITY RULE: Server secrets MUST NEVER be prefixed with NEXT_PUBLIC_.
# Only variables prefixed with NEXT_PUBLIC_ are bundled into client JavaScript.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRODUCTION ENVIRONMENT (.env.production / Vercel Production Environment)
# ------------------------------------------------------------------------------
# Server-Only Configuration & Secrets
SESSION_SECRET="prod_super_secure_session_key_min_32_characters_long_xyz"
ADMIN_API_KEY="prod_admin_secret_token_live"
TELEBIRR_API_SECRET="prod_telebirr_live_secret_key"
DATABASE_URL="postgresql://prod_user:prod_pass@ep-cool-db.us-east-1.aws.neon.tech/addis_eats?sslmode=require"
SITE_URL="https://addis-eats-nextjs-project.vercel.app"

# Client-Safe Public Variables
NEXT_PUBLIC_APP_NAME="Addis Eats"
NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
NEXT_PUBLIC_SHOW_CACHE_INDICATOR="false"
NEXT_PUBLIC_ENVIRONMENT="production"

# ------------------------------------------------------------------------------
# 2. PREVIEW ENVIRONMENT (.env.preview / Vercel Preview & Staging Environment)
# ------------------------------------------------------------------------------
# Server-Only Configuration & Secrets (Isolated staging sandboxes & mock gateways)
# SESSION_SECRET="preview_ephemeral_session_secret_key_testing_only"
# ADMIN_API_KEY="preview_admin_mock_secret_key"
# TELEBIRR_API_SECRET="preview_telebirr_sandbox_mock_key"
# DATABASE_URL="postgresql://preview_user:preview_pass@ep-staging-db.neon.tech/addis_eats_staging"
# SITE_URL="https://addis-eats-nextjs-project.vercel.app"

# Client-Safe Public Variables
# NEXT_PUBLIC_APP_NAME="Addis Eats (Preview)"
# NEXT_PUBLIC_DEFAULT_CURRENCY="USD"
# NEXT_PUBLIC_SHOW_CACHE_INDICATOR="true"
# NEXT_PUBLIC_ENVIRONMENT="preview"
